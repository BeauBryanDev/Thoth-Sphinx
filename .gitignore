# ...except the runtime lexicon priors in vision/, which cartouche_matcher.py
# and sphinx_corrector.py load via Path(__file__).parent. Without these the
# import chain and the test suite fail on a clean checkout (i.e. in CI).
!royal_names.json
!determinatives.json
!initial_particles.json

# Ignore all CSV Files
*.csv

# Ignore parquet files
*.parquet

# Ignore all SQL Files
*.sql

# ...except the Thoth evidence store: its search logic lives in db/*.sql,
# its measured results in reports/, and the knowledge-graph sources in knowledge/.
!db/*.sql
!reports/*.json
!reports/*.csv
!knowledge/*.json
!frontend/src/assets/*.svg
!frontend/src/assets/*.jpg
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig*.json
# Inogre all .pt files

*.pt

